{
  "name": "normal-10-devices",
  "description": "10 thiết bị ảo làm việc bình thường trong 60 s — đường cơ sở của hệ thống",
  "requires": [],
  "settleMs": 8000,
  "timeoutMs": 150000,
  "steps": [
    { "at": 0, "action": "note", "text": "Bắt đầu 10 thiết bị, 6 phiếu/phút mỗi máy" },
    { "at": 0, "action": "devices.start", "devices": 10, "rate": 6, "recognize": false },
    { "at": 60000, "action": "devices.stop" }
  ],
  "expect": [
    { "check": "receipts.delta", "op": ">=", "value": 50 },
    { "check": "requestId.unique", "op": "==", "value": true },
    { "check": "counter.netError", "op": "==", "value": 0 },
    { "check": "counter.otherError", "op": "==", "value": 0 },
    { "check": "save.p95Ms", "op": "<", "value": 2000 },
    { "check": "status.backendEnd", "op": "==", "value": "up" }
  ]
}
