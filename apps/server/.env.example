# Sao chép thành apps/server/.env (file .env đã được gitignore). Biến đặt sẵn trong shell được ưu tiên hơn file.
# Mọi biến đều có giá trị mặc định; chỉ cần đặt những gì muốn đổi.

# Địa chỉ/cổng bind. Mặc định loopback: PDA đi qua Vite proxy, không gọi thẳng BE.
# Đặt HOST=0.0.0.0 khi máy khác trong LAN (FE của người khác) cần gọi thẳng vào BE.
HOST=127.0.0.1
PORT=3000

# CORS cho FE chạy ở origin khác gọi thẳng /api (không qua proxy). Danh sách cách nhau bằng dấu phẩy.
# Rỗng = tắt. Ví dụ: CORS_ORIGINS=http://localhost:5174,https://192.168.1.20:5173
CORS_ORIGINS=

# Thư mục dữ liệu bền: SQLite + ảnh upload. Tương đối so với apps/server.
DATA_DIR=./data

# Giới hạn upload ảnh (byte). 10 MB.
MAX_UPLOAD_BYTES=10485760

# Provider nhận dạng: mock | http
RECOGNITION_PROVIDER=mock
# Ngân sách timeout DÙNG CHUNG cho cả 2 lần thử của một lần nhận dạng (ms).
# Attempt 1 hết giờ thì không còn retry — PDA không bao giờ phải chờ gấp đôi.
# Chuỗi timeout phải GIẢM DẦN từ ngoài vào trong: webapp 60000 > BE 20000 > ai-server
# UPSTREAM_TIMEOUT_MS 18000. Đặt lệch → BE ghi log warn "config.timeout_chain_invalid" lúc khởi động.
RECOGNITION_TIMEOUT_MS=20000
# Tổng số lần gọi provider (1 lần đầu + retry). Chờ giữa hai lần là RECOGNITION_RETRY_BACKOFF_MS.
RECOGNITION_MAX_ATTEMPTS=2
RECOGNITION_RETRY_BACKOFF_MS=500

# Semaphore nhận dạng: chạy đồng thời tối đa, xếp hàng tối đa, chờ tối đa trong hàng đợi.
# Vượt hàng đợi → 429 RECOGNITION_BUSY kèm retryAfterMs (không lưu ảnh, không tạo dòng DB).
# Chờ quá RECOGNITION_MAX_WAIT_MS: ở chế độ sync là 429; ở chế độ async (đã trả 202 rồi, không
# còn ai để trả mã lỗi) dòng recognitions được ghi status='failed', error_code='RECOGNITION_BUSY'
# để PDA đọc bằng GET /api/recognitions/:id và thôi chờ.
RECOGNITION_MAX_CONCURRENT=3
RECOGNITION_MAX_WAITING=10
RECOGNITION_MAX_WAIT_MS=30000
RECOGNITION_BUSY_RETRY_AFTER_MS=3000

# Timeout khi BE probe GET /health của ai-server để biết OCR còn sống (kết quả cache 10 s).
OCR_PROBE_TIMEOUT_MS=3000

# Bắt buộc mọi POST /api/recognitions và /api/receipts phải mang header x-device-id.
# Mặc định trong code vẫn là false (Q14) để 95 test cũ không phải sửa; môi trường dev/production
# bật bằng đúng dòng dưới đây. FE từ Phase 3 đã luôn gửi header này.
REQUIRE_DEVICE_ID=true

# Chế độ mặc định của provider mock: success | slow | error | timeout
MOCK_MODE=success
# Độ trễ của mock ở chế độ success / slow (ms)
MOCK_DELAY_MS=700
MOCK_SLOW_DELAY_MS=6000

# Bật scenario engine: query ?sim=/?simSave=, 5 endpoint /api/admin/sim* và sim middleware.
# Đặt false khi chạy thật: /api/admin/sim* trả 403 SIM_DISABLED và không kịch bản nào được áp.
SIM_OVERRIDE=true
# Mô phỏng lỗi lưu bản ghi cho MỌI request POST /api/receipts (khác với OCR lỗi).
SIM_SAVE_FAIL=false

# Provider http: gọi AI server (apps/ai-server). Bật bằng 2 dòng đầu; LLM chậm hơn mock
# nên nới timeout.
# RECOGNITION_PROVIDER=http
# AI_SERVER_URL=http://127.0.0.1:8000/recognize
# Shared secret, phải trùng AI_SERVER_API_KEY trong apps/ai-server/.env (để trống = không dùng)
# AI_SERVER_API_KEY=
# Base URL công khai của BE để AI server tải ảnh qua GET /api/images/:id (chỉ cần nếu AI server
# nhận URL thay vì binary; apps/ai-server nhận binary nên không cần).
# PUBLIC_BASE_URL=http://10.0.0.5:3000

# ── Phase 4: vòng đời phiếu, outbox và SAP ────────────────────────────────────────────────
# Adapter SAP đang dùng: mock | none. none = tắt hoàn toàn outbox + worker (status.sap báo
# not_configured). SAP thật (http) là Phase 7.
SAP_ADAPTER=mock
# Timeout mỗi lần gọi SAP (ms). Đặt nhỏ hơn SAP_MOCK_SLOW_DELAY_MS để xem mode slow hoá timeout.
SAP_TIMEOUT_MS=15000
# Tổng số lần gọi SAP cho một phiếu (tính cả lần đầu). Hết lượt vì lỗi kỹ thuật → post_failed.
SAP_MAX_ATTEMPTS=5
# Độ trễ của SAP mock ở mode success / slow (ms).
SAP_MOCK_SUCCESS_DELAY_MS=300
SAP_MOCK_SLOW_DELAY_MS=8000

# Bật worker nền xử lý outbox. false = job vẫn được tạo nhưng không ai xử lý (để thử tay).
OUTBOX_ENABLED=true
# Chu kỳ worker quét bảng outbox (ms), 20..60000.
OUTBOX_TICK_MS=1000
# Chờ bao lâu trước attempt thứ 2, 3, 4, 5 (ms, CSV). Tệ nhất mất ~3 phút 35 giây.
OUTBOX_BACKOFF_MS=5000,15000,60000,60000

# Quy tắc nghiệp vụ v1: chống trùng nhãn và kiểm vị trí theo danh mục kho.
RULE_DUPLICATE=true
RULE_LOCATION=true
# Thư mục danh mục tĩnh (locations.csv, warehouses.json, shifts.json).
# Mặc định apps/server/src/master-data — là MÃ NGUỒN có version, không phải dữ liệu runtime.
# MASTER_DIR=

# Lệch múi giờ của kho so với UTC, tính bằng phút. 420 = UTC+7 (Việt Nam). Chỉ dùng cho khoá
# nghiệp vụ "cùng ngày" khi chống trùng nhãn; mọi mốc thời gian lưu trữ vẫn là UTC.
TZ_OFFSET_MINUTES=420

# ── Phase 5: nhận dạng bất đồng bộ ────────────────────────────────────────────────────────
# sync  = trả kết quả ngay trong response (hành vi Phase 1-4, MẶC ĐỊNH — đổi giá trị này là
#         đổi hành vi của POST /api/recognitions từ 201 sang 202).
# async = trả 202 rồi xử lý nền; PDA poll GET /api/recognitions/:id cho tới khi hết 'pending'.
RECOGNITION_MODE=sync
# Gợi ý cho client: chờ bao lâu rồi hãy poll lần đầu (ms, 200..10000). Vào body `pollAfterMs`
# và header `retry-after` của response 202.
RECOGNITION_POLL_HINT_MS=1000

# ── Phase 5: sổ sự kiện toàn hệ thống cho màn hình giám sát ───────────────────────────────
# false = events.write() là no-op và GET /api/admin/events trả items rỗng (để đo hiệu năng).
EVENTS_ENABLED=true
# Số dòng system_events giữ lại (100..100000). Vượt thì cắt bớt dòng cũ nhất.
EVENTS_MAX_ROWS=2000
# Cứ mỗi N lần ghi thì chạy cắt một lần (1..10000).
EVENTS_TRIM_EVERY=100
# false = không ghi gương receipt_events sang system_events (dòng sự kiện sẽ không có phiếu).
EVENTS_MIRROR_RECEIPTS=true
