# Sao chép thành ai-server/.env (đã gitignore). KHÔNG commit key.

# --- Lựa chọn 1: OpenAI (dùng quota free sẵn có) ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Lựa chọn 2: Google Gemini free tier qua endpoint tương thích OpenAI ---
# Lấy key tại https://aistudio.google.com/apikey
# OPENAI_API_KEY=AIza...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-2.0-flash

# Cổng AI server (Main BE gọi tới http://127.0.0.1:8000/recognize)
HOST=127.0.0.1
PORT=8000

# Shared secret giữa Main BE và AI server. Để trống = không kiểm tra.
# Nếu đặt, apps/server/.env phải có AI_SERVER_API_KEY cùng giá trị.
AI_SERVER_API_KEY=

# Timeout gọi LLM (ms) và giới hạn ảnh nhận vào (byte).
# 18000: chuỗi timeout phải GIẢM DẦN từ ngoài vào trong — webapp 60000 > Main BE 20000 >
# ai-server 18000 > (LLM). Nếu đặt bằng hoặc lớn hơn RECOGNITION_TIMEOUT_MS của BE thì BE luôn
# bỏ cuộc TRƯỚC, người vận hành chỉ thấy "BE bỏ cuộc" chứ không biết là "OCR chậm".
# Đo thật với gpt-4o-mini: p50 5,3 s · p90 7,6 s · max 15,2 s → 18 s vẫn dư.
# Ảnh siêu lớn chậm hơn thì tăng biến này (và tăng cả 2 tầng ngoài), đừng sửa code.
UPSTREAM_TIMEOUT_MS=18000
MAX_UPLOAD_BYTES=10485760

# Thử lại 1 lần cho lỗi TẠM THỜI (HTTP 429, 5xx, JSON hỏng, bị cắt vì max_tokens, lỗi kết nối).
# Không thử lại với 400/401/403 và NOT_CONFIGURED. Cả 2 lần dùng CHUNG ngân sách
# UPSTREAM_TIMEOUT_MS, và chỉ thử lại khi còn ≥ 2000 ms.
UPSTREAM_MAX_ATTEMPTS=2
UPSTREAM_RETRY_BACKOFF_MS=500

# Trần token output cho mỗi lần gọi LLM. Đo thật: completion ~210 token, nên 900 vẫn dư gấp 4 lần
# nhưng giảm rủi ro finish_reason="length" (lỗi TRUNCATED) mà vẫn bị tính tiền.
MAX_OUTPUT_TOKENS=900

# --- Giả lập dịch vụ OCR hỏng (để demo/dev, không tốn quota) ---
# OCR_SIM_MODE khác passthrough → KHÔNG gọi OpenAI, KHÔNG cần OPENAI_API_KEY (tiết kiệm quota).
# passthrough | slow | error | timeout | partial | garbage
#   passthrough : gọi LLM thật như bình thường
#   slow        : chờ OCR_SIM_DELAY_MS rồi trả mẫu (mặc định 25 s > 18 s → 504 UPSTREAM_TIMEOUT)
#   error       : trả ngay 502 UPSTREAM_ERROR (mô phỏng LLM API trả HTTP 500)
#   timeout     : treo tới khi hết UPSTREAM_TIMEOUT_MS → 504 UPSTREAM_TIMEOUT
#   partial     : trả mẫu nhưng thiếu trường (part_number, ship_date, supplier… rỗng)
#   garbage     : trả mẫu với chữ rác, để thử luồng người vận hành sửa tay
# Mọi mode mô phỏng: model = "sim-<mode>", usage = null.
OCR_SIM_MODE=passthrough
OCR_SIM_DELAY_MS=25000
# Độ chi tiết ảnh gửi LLM: high (đọc chữ nhỏ tốt hơn, tốn token hơn) | low | auto
IMAGE_DETAIL=high
