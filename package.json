{
  "name": "pda-scan",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:webapp": "npm run dev --workspace @pda-scan/webapp",
    "dev:server": "npm run dev --workspace @pda-scan/server",
    "dev:ai": "npm run dev --workspace @pda-scan/ai-server",
    "start:server": "npm run start --workspace @pda-scan/server",
    "build": "npm run build --workspace @pda-scan/webapp",
    "preview": "npm run preview --workspace @pda-scan/webapp",
    "test": "npm run test --workspaces --if-present && npm run test:sim",
    "test:server": "npm run test --workspace @pda-scan/server",
    "test:ai": "npm run test --workspace @pda-scan/ai-server",
    "test:sim": "node --test \"scripts/sim/test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  }
}
